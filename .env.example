# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Google Cloud Platform
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# Firestore Collections
FIRESTORE_AGENTS_COLLECTION=agents
FIRESTORE_SESSIONS_COLLECTION=sessions

# Session Management
# Sessions expire after this many minutes of inactivity
# A new conversation session will be created with Vertex AI after expiry
SESSION_TIMEOUT_MINUTES=30

# Orphaned tool calls
# A run cut off between an agent's tool call and the tool's result leaves the
# session replaying a call with no answer, which Anthropic-backed agents
# reject on every later turn. Set this true to let the Forum append a
# synthetic "interrupted, side effects unconfirmed" result on the next turn.
# Off by default: it writes into an agent's own conversation history, and
# agents built from the current Agent-Template already repair this
# themselves. Requires aiplatform.sessions.list and .appendEvent on each
# agent's reasoning engine. See docs/TROUBLESHOOTING.md.
HEAL_ORPHANED_TOOL_CALLS=false
# How long an unanswered tool call must sit at the tail of a session before
# the Forum accepts that no result is coming.
HEAL_GRACE_SECONDS=120
# How long a run must be in flight before the Forum concludes it was cut off
# rather than merely slow. Longer than any run can survive (Cloud Run's own
# request timeout is 300s), because treating a live run as abandoned is the
# expensive mistake.
CUT_OFF_AFTER_SECONDS=600

# Fallback IANA timezone used when telling agents what local time a user
# sent a message, for users with no default_timezone set (editable in the
# admin UI). Use a location name like America/New_York — not "EST" — so
# daylight saving is handled correctly.
DEFAULT_USER_TIMEZONE=America/New_York

# Slack Configuration
# Comma-separated list of signing secrets (one per Slack app)
# Get each from: api.slack.com/apps → Your App → Basic Information → App Credentials → Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret-1,your-signing-secret-2

# API Configuration
API_V1_PREFIX=/api/v1

# GCS File Upload (required for file/image support)
# File attachments are uploaded to GCS and agents receive a gs:// URI in an
# [IMAGE: ...] or [FILE: ...] token. With GCS_BUCKET_NAME empty there is no
# channel to carry the bytes, so inbound files are dropped before the agent.
# Recommended naming: {PROJECT_ID}-slack-files
GCS_BUCKET_NAME=your-project-id-slack-files
GCS_FILE_PREFIX=slack-files

# Attachment size caps, in MB. Images and documents are capped separately:
# a scanned multi-page invoice is legitimately larger than a photo.
# Which MIME types an agent receives at all is per-agent, set via that
# agent's accepted_file_types field (see docs/FOR_AGENT_DEVELOPERS.md).
MAX_IMAGE_SIZE_MB=20
MAX_DOCUMENT_SIZE_MB=20

# Admin UI (optional — leave blank to disable the /admin pages entirely)
# When all four required values are set, the admin UI is mounted at /admin.
# Create the OAuth 2.0 Web Client in GCP Console → APIs & Services →
# Credentials, and add the callback URL below as an authorized redirect URI.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Set this to the full callback URL of your deployment:
#   https://<cloud-run-host>/admin/auth/callback
# Or for local dev:
#   http://localhost:8080/admin/auth/callback
# (Google OAuth accepts http://localhost but not http://127.0.0.1.)
OAUTH_REDIRECT_URI=
# Random secret used to sign the admin session cookie. Generate with
# `openssl rand -hex 32`. Required when OAUTH_* are set.
SESSION_SECRET=
# IAM role the operator must hold on GCP_PROJECT_ID to access the admin UI.
ADMIN_REQUIRED_ROLE=roles/owner
# Cloud Run service name used to scope Cloud Logging queries. Defaults to
# "the-forum" (matches the bundled terraform). Override if you renamed it.
CLOUD_RUN_SERVICE_NAME=the-forum

# Local Development Only (optional)
# Uncomment when using Firestore emulator locally
# FIRESTORE_EMULATOR_HOST=localhost:8681
